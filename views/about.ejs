<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>
<section class="section">
  <div class="wrap">
    <div class="hero-grid" style="align-items:center">
      <div>
        <div class="eyebrow">The producer</div>
        <h1><%= studio.producer %></h1>
        <p class="hero-lede">
          <%= studio.producer %> has been building beats in Accra for over a decade — afrobeats drums that sit deep,
          trap 808s that translate on phone speakers, and R&amp;B chords with room to breathe. The studio licences
          directly to artists: no managers, no label, no waiting.
        </p>
        <p>Every beat in the store is written, arranged and mixed in-house. Buy a lease, a premium WAV, or take the
          exclusive with stems. Payment by Mobile Money or bank transfer, delivery by email.</p>
        <div class="hero-badges">
          <div class="hero-badge"><strong><%= beats %></strong><span>Beats produced</span></div>
          <div class="hero-badge"><strong><%= videos %></strong><span>Videos</span></div>
          <div class="hero-badge"><strong>10+</strong><span>Years in the lab</span></div>
        </div>
      </div>
      <div class="eq-stage">
        <div class="eq-top"><span class="live-dot"><i></i> Studio A</span><span>Accra, GH</span></div>
        <div class="equalizer" data-bars="40" aria-hidden="true"></div>
        <div class="now">
          <div class="now-cover">🎚</div>
          <div>
            <div class="now-title">Cook-up in progress</div>
            <div class="now-sub">New beats drop weekly</div>
          </div>
          <div class="wave"></div>
        </div>
      </div>
    </div>

    <div class="grid grid-3" style="margin-top:56px">
      <div class="panel panel-pad">
        <div class="eyebrow">Licence</div>
        <h3>Simple, transparent rights</h3>
        <p style="margin:0;font-size:.88rem">Lease, premium or exclusive — each licence page spells out streams, file type and exclusivity. No hidden clauses.</p>
      </div>
      <div class="panel panel-pad">
        <div class="eyebrow">Payment</div>
        <h3>Mobile Money &amp; bank</h3>
        <p style="margin:0;font-size:.88rem">Pay with MTN, Telecel or AirtelTigo Money, or transfer to the studio's bank account. Local rails, no card needed.</p>
      </div>
      <div class="panel panel-pad">
        <div class="eyebrow">Delivery</div>
        <h3>In your inbox</h3>
        <p style="margin:0;font-size:.88rem">The moment payment clears, your download link and receipt are emailed — and saved in your dashboard forever.</p>
      </div>
    </div>

    <div class="panel panel-pad" style="margin-top:26px;background:var(--grad-soft)">
      <div class="section-head" style="margin-bottom:0">
        <div>
          <h2 style="margin-bottom:6px">Need a custom beat?</h2>
          <p style="margin:0">Create an account and message the studio from your dashboard — every message lands in the producer's inbox and email.</p>
        </div>
        <a href="/register" class="btn btn-primary">Talk to the producer</a>
      </div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
<%- include('partials/player') %>
<script src="/js/app.js"></script>
</body>
</html>
