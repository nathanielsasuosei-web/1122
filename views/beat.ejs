<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>
<div class="wrap" style="padding:34px 0 20px">
  <p style="font-size:.82rem;margin-bottom:20px"><a href="/beats" class="muted">← Back to store</a></p>
  <div class="checkout-grid">
    <div>
      <div class="panel" style="overflow:hidden;margin-bottom:22px">
        <div style="position:relative;aspect-ratio:16/9;background:var(--panel-2)">
          <% if (beat.cover_image) { %>
            <img src="<%= beat.cover_image %>" alt="<%= beat.title %>" style="width:100%;height:100%;object-fit:cover">
          <% } else { %>
            <div class="fallback" style="position:absolute;inset:0;display:grid;place-items:center;background:var(--grad-soft);font-family:var(--display);font-size:3rem;color:rgba(255,255,255,.3)"><%= beat.title.slice(0,2).toUpperCase() %></div>
          <% } %>
          <div style="position:absolute;inset:auto 16px 16px 16px;display:flex;gap:8px;flex-wrap:wrap">
            <% if (beat.genre) { %><span class="chip chip-violet"><%= beat.genre %></span><% } %>
            <% if (beat.bpm) { %><span class="chip"><%= beat.bpm %> BPM</span><% } %>
            <% if (beat.musical_key) { %><span class="chip chip-cyan"><%= beat.musical_key %></span><% } %>
          </div>
        </div>
        <div class="panel-body">
          <div style="display:flex;justify-content:space-between;gap:16px;align-items:start;flex-wrap:wrap;margin-bottom:18px">
            <div>
              <h1 style="font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:6px"><%= beat.title %></h1>
              <p style="margin:0;font-size:.9rem">Produced by <%= studio.producer %></p>
            </div>
            <div style="font-family:var(--display);font-size:1.7rem;font-weight:700;color:var(--pink)"><%= money(beat.price_cents) %></div>
          </div>
          <% if (beat.audio_file) { %>
            <div style="display:flex;align-items:center;gap:12px;background:#0b0813;border:1px solid var(--line);border-radius:14px;padding:12px 16px">
              <button class="play-btn"
                data-play="<%= beat.id %>" data-src="<%= beat.audio_file %>" data-title="<%= beat.title %>"
                data-meta="<%= [beat.genre, beat.bpm ? beat.bpm + ' BPM' : null, beat.musical_key].filter(Boolean).join(' · ') %>"
                data-cover="<%= beat.cover_image || '' %>" data-href="/checkout/<%= beat.id %>" aria-label="Play preview">
                <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </button>
              <div>
                <div style="font-weight:600;font-size:.9rem">Untagged preview</div>
                <div class="muted" style="font-size:.78rem">Stream the full beat before you buy</div>
              </div>
            </div>
          <% } else { %>
            <div class="notice">Audio for this beat hasn't been uploaded yet — the producer is on it.</div>
          <% } %>
          <% if (beat.description) { %>
            <p style="margin:20px 0 0"><%= beat.description %></p>
          <% } %>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head"><h2>Licences</h2><span class="muted" style="font-size:.8rem">Same beat, different rights</span></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Licence</th><th>What you get</th><th style="text-align:right">Price</th><th></th></tr></thead>
            <tbody>
              <% Object.entries(licenses).forEach(function ([key, lic]) { %>
                <tr>
                  <td class="t-title"><%= lic.label %></td>
                  <td><span class="t-sub"><%= lic.blurb %></span></td>
                  <td style="text-align:right;font-weight:700;white-space:nowrap"><%= money(beat.price_cents * lic.multiplier) %></td>
                  <td style="text-align:right"><a class="btn btn-primary btn-sm" href="/checkout/<%= beat.id %>?license=<%= key %>">Buy</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <aside class="panel summary panel-pad">
      <h3 style="margin-bottom:14px">Buy this beat</h3>
      <div class="summary-row"><span>Beat</span><span style="color:#fff"><%= beat.title %></span></div>
      <div class="summary-row"><span>Tempo</span><span><%= beat.bpm || '—' %> BPM</span></div>
      <div class="summary-row"><span>Key</span><span><%= beat.musical_key || '—' %></span></div>
      <div class="summary-row"><span>Delivery</span><span>Email, instant</span></div>
      <div class="summary-row total"><span>From</span><span><%= money(beat.price_cents) %></span></div>
      <a class="btn btn-primary btn-block" style="margin-top:16px" href="/checkout/<%= beat.id %>">Choose licence →</a>
      <ul class="list-plain" style="margin-top:20px">
        <li>Mobile Money &amp; bank transfer</li>
        <li>Email delivery + receipt</li>
        <li>Re-download any time</li>
      </ul>
    </aside>
  </div>

  <% if (related.length) { %>
    <div style="margin-top:46px">
      <h2 style="font-size:1.3rem">More <%= beat.genre || 'beats' %></h2>
      <div class="grid grid-3" style="margin-top:18px">
        <% related.forEach(function (r) { %><%- include('partials/beat-card', { beat: r }) %><% }) %>
      </div>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
<%- include('partials/player') %>
<script src="/js/app.js"></script>
</body>
</html>
