<div class="now-bar" id="nowBar">
  <div class="wrap now-inner">
    <span class="eq-mini"><i></i><i></i><i></i><i></i></span>
    <img class="art" id="nowArt" alt="">
    <div class="info">
      <strong id="nowTitle">—</strong>
      <span id="nowMeta"></span>
    </div>
    <button class="play-btn" id="nowToggle" aria-label="Play/pause"></button>
    <div class="progress" id="nowProgress"><div class="progress-fill" id="nowFill"></div></div>
    <span class="time" id="nowTime">0:00</span>
    <a class="btn btn-primary btn-sm" id="nowBuy" href="/beats">Buy</a>
  </div>
  <audio id="player" preload="metadata"></audio>
</div>
