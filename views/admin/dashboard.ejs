<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<div class="wrap shell">
  <%- include('../partials/dash-nav', { unreadCount: unreadMessages }) %>
  <div>
    <div class="page-head">
      <div>
        <div class="eyebrow">Producer area</div>
        <h1>Studio overview</h1>
        <p>Upload beats and videos, track sales, and answer artists.</p>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a href="/admin/beats" class="btn btn-primary btn-sm">+ Upload beat</a>
        <a href="/admin/videos" class="btn btn-ghost btn-sm">+ Add video</a>
      </div>
    </div>

    <%- include('../partials/flash') %>

    <div class="grid grid-4" style="margin-bottom:22px">
      <div class="stat">
        <div class="label">Revenue</div>
        <div class="value"><%= money(revenue) %></div>
        <div class="delta">paid licences only</div>
      </div>
      <div class="stat">
        <div class="label">Pending payments</div>
        <div class="value"><%= pending %></div>
        <div class="delta"><a href="/admin/orders?status=pending" style="color:var(--amber)">Review →</a></div>
      </div>
      <div class="stat">
        <div class="label">Artists</div>
        <div class="value"><%= counts.artists %></div>
        <div class="delta">registered accounts</div>
      </div>
      <div class="stat">
        <div class="label">Unread messages</div>
        <div class="value"><%= unreadMessages %></div>
        <div class="delta"><a href="/admin/messages" style="color:var(--cyan)">Open inbox →</a></div>
      </div>
    </div>

    <div class="split-2">
      <div class="panel">
        <div class="panel-head"><h2>Recent sales</h2><a href="/admin/orders" class="btn btn-ghost btn-sm">All orders</a></div>
        <% if (!sales.length) { %>
          <div class="empty"><p>No paid orders yet. Place a test order from the storefront to see the flow.</p></div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <tbody>
                <% sales.forEach(function (s) { %>
                  <tr>
                    <td>
                      <div class="t-title"><%= s.title %></div>
                      <div class="t-sub"><%= s.artist %> · <%= (s.paid_at || '').slice(0, 10) %></div>
                    </td>
                    <td style="text-align:right;white-space:nowrap">
                      <div style="font-weight:700"><%= money(s.amount_cents) %></div>
                      <div class="t-sub"><%= s.method === 'bank' ? 'Bank' : 'MoMo' %></div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <div class="panel">
        <div class="panel-head"><h2>Store contents</h2><a href="/admin/beats" class="btn btn-ghost btn-sm">Manage</a></div>
        <div class="panel-body">
          <div class="summary-row"><span>Beats in store</span><span style="color:#fff"><%= counts.beats %></span></div>
          <div class="summary-row"><span>Videos</span><span style="color:#fff"><%= counts.videos %></span></div>
          <div class="summary-row"><span>Total orders</span><span style="color:#fff"><%= counts.orders %></span></div>
          <div class="summary-row"><span>Emails generated</span><span style="color:#fff"><%= counts.mail %></span></div>
          <div class="divider"></div>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
            <div>
              <div class="label-sm" style="margin:0">Email delivery</div>
              <div class="muted" style="font-size:.82rem"><%= smtpOn ? 'SMTP configured ✓' : 'Offline mailbox (no SMTP)' %></div>
            </div>
            <a href="/admin/settings" class="btn btn-ghost btn-sm">Configure</a>
          </div>
        </div>
      </div>
    </div>

    <div class="panel" style="margin-top:22px">
      <div class="panel-head"><h2>Latest emails</h2><a href="/admin/mailbox" class="btn btn-ghost btn-sm">Open mailbox</a></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Subject</th><th>To</th><th>Type</th><th>Status</th></tr></thead>
          <tbody>
            <% recentMail.forEach(function (m) { %>
              <tr>
                <td><a href="/admin/mailbox?id=<%= m.id %>" class="t-title"><%= m.subject %></a></td>
                <td class="t-sub"><%= m.to_email %></td>
                <td><span class="chip chip-violet"><%= m.category %></span></td>
                <td><span class="badge <%= m.sent ? 'paid' : (m.error ? 'failed' : 'info') %>"><%= m.sent ? 'sent' : (m.error ? 'error' : 'queued') %></span></td>
              </tr>
            <% }) %>
            <% if (!recentMail.length) { %><tr><td colspan="4" class="empty">No emails generated yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
<script src="/js/app.js"></script>
</body>
</html>
