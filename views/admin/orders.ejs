<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<div class="wrap shell">
  <%- include('../partials/dash-nav') %>
  <div>
    <div class="page-head">
      <div>
        <div class="eyebrow">Payments</div>
        <h1>Orders</h1>
        <p>Confirm bank transfers manually, or watch Mobile Money confirm itself.</p>
      </div>
      <div style="text-align:right">
        <div class="label-sm" style="margin:0">Filtered revenue</div>
        <div style="font-family:var(--display);font-size:1.4rem;font-weight:700;color:var(--cyan)"><%= money(revenue) %></div>
      </div>
    </div>

    <%- include('../partials/flash') %>

    <div class="pill-tabs" style="margin-bottom:18px">
      <a href="/admin/orders" class="<%= status === 'all' ? 'active' : '' %>">All</a>
      <a href="/admin/orders?status=pending" class="<%= status === 'pending' ? 'active' : '' %>">Pending</a>
      <a href="/admin/orders?status=paid" class="<%= status === 'paid' ? 'active' : '' %>">Paid</a>
      <a href="/admin/orders?status=failed" class="<%= status === 'failed' ? 'active' : '' %>">Failed</a>
    </div>

    <div class="panel">
      <% if (!orders.length) { %>
        <div class="empty"><p>No orders in this view.</p></div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Reference</th><th>Beat</th><th>Artist</th><th>Method</th><th>Amount</th><th>Status</th><th>Placed</th><th>Actions</th></tr></thead>
            <tbody>
              <% orders.forEach(function (o) { %>
                <tr>
                  <td class="mono"><%= o.reference %></td>
                  <td>
                    <div class="t-title"><%= o.title %></div>
                    <div class="t-sub"><%= licenses[o.license] ? licenses[o.license].label : o.license %></div>
                  </td>
                  <td>
                    <div class="t-title"><%= o.artist %></div>
                    <div class="t-sub"><%= o.email %></div>
                  </td>
                  <td class="t-sub">
                    <%= o.method === 'bank' ? 'Bank transfer' : (providers[o.provider] ? providers[o.provider].label : 'Mobile Money') %>
                    <% if (o.account_number) { %><br><span class="mono"><%= o.account_number %></span><% } %>
                  </td>
                  <td style="font-weight:700;white-space:nowrap"><%= money(o.amount_cents) %></td>
                  <td><span class="badge <%= o.status %>"><%= o.status %></span></td>
                  <td class="t-sub"><%= (o.created_at || '').slice(0, 16) %></td>
                  <td>
                    <div class="table-actions">
                      <% if (o.status === 'pending') { %>
                        <form method="post" action="/admin/orders/<%= o.reference %>/confirm"><button class="btn btn-primary btn-sm" type="submit" title="Mark paid and email the download">Confirm</button></form>
                        <form method="post" action="/admin/orders/<%= o.reference %>/fail"><button class="btn btn-danger btn-sm" type="submit">Fail</button></form>
                      <% } else if (o.status === 'paid') { %>
                        <a class="btn btn-ghost btn-sm" href="/download/<%= o.download_token %>">File</a>
                      <% } else { %>
                        <span class="t-sub">—</span>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
    <p class="hint" style="margin-top:14px">“Confirm” marks the order paid, unlocks the download and sends the payment-confirmed + new-sale emails.</p>
  </div>
</div>
<%- include('../partials/footer') %>
<script src="/js/app.js"></script>
</body>
</html>
