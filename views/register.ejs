<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>
<div class="wrap auth-page">
  <div class="center-narrow">
    <div style="text-align:center;margin-bottom:26px">
      <div class="eyebrow" style="justify-content:center">Free artist account</div>
      <h1 style="font-size:clamp(1.8rem,4vw,2.5rem)">Join the studio</h1>
      <p>Buy licences, download instantly, and talk to the producer directly.</p>
    </div>
    <%- include('partials/flash') %>
    <div class="panel panel-pad">
      <form method="post" action="/register">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field">
          <label for="name">Artist / full name</label>
          <input class="input" id="name" name="name" required autocomplete="name" value="<%= form.name || '' %>" placeholder="Kojo Mensah">
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input class="input" id="email" name="email" type="email" required autocomplete="email" value="<%= form.email || '' %>" placeholder="you@studio.com">
          <div class="hint">Your download links and receipts are sent here.</div>
        </div>
        <div class="row row-2">
          <div class="field">
            <label for="password">Password</label>
            <input class="input" id="password" name="password" type="password" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters">
          </div>
          <div class="field">
            <label for="confirm">Confirm password</label>
            <input class="input" id="confirm" name="confirm" type="password" required minlength="8" autocomplete="new-password" placeholder="Repeat it">
          </div>
        </div>
        <button class="btn btn-primary btn-block" type="submit" style="margin-top:8px">Create my account</button>
      </form>
      <div class="divider"></div>
      <p style="text-align:center;margin:0;font-size:.88rem">Already have an account? <a href="/login" style="color:var(--pink);font-weight:600">Log in</a></p>
    </div>
    <ul class="list-plain" style="margin-top:24px">
      <li>Untagged MP3 / WAV downloads</li>
      <li>Orders, receipts and re-downloads in one dashboard</li>
      <li>Message the producer — replies come by email too</li>
    </ul>
  </div>
</div>
<%- include('partials/footer') %>
<script src="/js/app.js"></script>
</body>
</html>
