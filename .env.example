# ── Studio identity ───────────────────────────────────────────────
STUDIO_NAME="Bassline Studio"
STUDIO_EMAIL="hello@bassline.studio"
PRODUCER_NAME="Kobby Waves"
STUDIO_TAGLINE="Beats engineered in Accra. Licensed worldwide."

# ── Producer (admin) login — created on first run ─────────────────
ADMIN_EMAIL="admin@bassline.studio"
ADMIN_PASSWORD="producer123"

# ── Server ────────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET="change-this-to-a-long-random-string"
# PUBLIC_URL="https://yourdomain.com"   # used in email links
# COOKIE_SECURE=true                    # force Secure cookies behind a TLS proxy

# ── Storage ───────────────────────────────────────────────────────
# Where the SQLite database and new uploads live.
# Defaults: ./data/producer.db + ./public/uploads, or /tmp/bassline-studio on
# read-only hosts (Vercel/Lambda). On Docker/Render/Fly point both at the volume.
# STUDIO_STORAGE_DIR=/data
# DB_FILE=/data/producer.db
# UPLOAD_DIR=/data/uploads

# ── Payments ──────────────────────────────────────────────────────
# demo  = orders auto-confirm after a few seconds (great for testing)
# live  = implement your PSP in lib/payments.js
PAYMENTS_MODE=demo
DEMO_PAYMENT_DELAY_MS=6000

BANK_NAME="Ecobank Ghana"
BANK_ACCOUNT_NAME="Bassline Studio"
BANK_ACCOUNT_NUMBER="1441 0023 4567 89"
BANK_BRANCH="Osu, Accra"
BANK_SWIFT="ECOCGHAC"

# ── Email (optional) ──────────────────────────────────────────────
# Leave blank and every email is stored in the admin Mailbox tab instead.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
MAIL_FROM="Bassline Studio <no-reply@bassline.studio>"
